# Chave da API da Anthropic, usada para narrar as partidas com IA (Claude).
# Sem essa chave o jogo funciona normalmente, mas usa um simulador local
# (mais simples, sem narração gerada por IA) como fallback automático.
ANTHROPIC_API_KEY=

# Modelo usado para a narração (opcional).
ANTHROPIC_MODEL=claude-sonnet-5

# Porta do servidor.
PORT=3001

# URL do frontend (usada para CORS e para montar o link do QR Code da sala).
FRONTEND_URL=http://localhost:5173
